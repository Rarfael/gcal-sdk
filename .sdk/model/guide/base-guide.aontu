# Guide

guide: {
  metrics: count: entity: 1
  metrics: count: path: 2
  metrics: count: method: 5

  entity: event: {
    path: "/calendars/primary/events": {
      op: create: method: *POST
      op: list: method: *GET
      op: list: transform: res: *("`body.items`")|top
    }
    path: "/calendars/primary/events/{eventId}": {
      rename: param: "eventId": *"id"
      op: load: method: *GET
      op: patch: method: *PATCH
      op: remove: method: *DELETE
    }
  }

}